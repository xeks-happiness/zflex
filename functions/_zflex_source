# Function used for "source" subcommand of zflex
# NOTE: Because of nature of shell and zsh plugins this function
# is autoloaded from zflex.zsh instead of being seperate shell script
function _zflex_source {
	local plugin_dir confirmation initfiles

	case "$1" in
		-y)
			for plugin_dir in $ZFLEX_PLUGIN_DIR/*; do
				initfiles=($plugin_dir/*.{plugin.zsh,zsh-theme,zsh,sh}(N))
				source $initfiles[1]
				print "Sourced ${plugin_dir:t}"
			done
			return
			;;
		-q)
			for plugin_dir in $ZFLEX_PLUGIN_DIR/*; do
				initfiles=($plugin_dir/*.{plugin.zsh,zsh-theme,zsh,sh}(N))
				(( $+functions[zsh-defer] )) && zsh-defer source $initfiles[1] || source $initfiles[1]
			done
			return
			;;
	esac

	if ! (( $#@ )); then
		print -n "Source all currently installed plugins? [y/N]: "
		read -r confirmation
		case "$confirmation" in
			y|Y)
				for plugin_dir in $ZFLEX_PLUGIN_DIR/*; do
					initfiles=($plugin_dir/*.{plugin.zsh,zsh-theme,zsh,sh}(N))
					(( $+functions[zsh-defer] )) && zsh-defer . $initfiles[1] || . $initfiles[1]
					print "Sourced ${plugin_dir:t}"
				done
				return
				;;
			n|N|''|*)
				print "Aborted"
				return
				;;
		esac
	else
		for plugin_dir in "$ZFLEX_PLUGIN_DIR/$@"; do
			initfiles=($plugin_dir/*.{plugin.zsh,zsh-theme,zsh,sh}(N))
			(( $+functions[zsh-defer] )) && zsh-defer . $initfiles[1] || . $initfiles[1]
		done
	fi
}
